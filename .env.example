# Paste secrets into .env, never into chat. Restart with: .venv\Scripts\python scripts/run.py
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMENSIONS=1536

# A dense-vector index using cosine similarity and 1536 dimensions.
PINECONE_API_KEY=
# Index HOST from Pinecone console, not the console URL or index name.
PINECONE_INDEX_HOST=
PINECONE_API_VERSION=2026-07
# For a document index with integrated embeddings, set these two fields.
# Leave PINECONE_EMBED_FIELD empty for an index that accepts raw vectors.
PINECONE_EMBED_FIELD=
PINECONE_EMBED_MODEL=text-embedding-3-small

R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Google OAuth application type: Web application.
# Add exactly this redirect URI to Google; use your HTTPS domain when hosting.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_REDIRECT_URI=http://localhost:8501/oauth2callback
# Generated automatically in your local .env. Keep stable across restarts.
AUTH_COOKIE_SECRET=

PORT=8501
MAX_FILE_MB=20
MAX_FILES_PER_PROJECT=30
MAX_CHUNKS_PER_FILE=1500
MAX_PROJECTS_PER_USER=20
MAX_MESSAGES_PER_PROJECT=1000
